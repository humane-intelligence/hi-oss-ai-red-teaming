# Deployment environment — one of: test, local, dev, prod.
ENVIRONMENT=local

# Deployed commit SHA — set by deploy.sh on the box; leave empty locally (surfaced as "dev").
GIT_SHA=

DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=ai_red_teaming

# Password for the read-only `monitoring` Postgres role. Unset = `make seedlocal`
# skips creating it. Non-secret local default — matches the compose
# `postgres-exporter` service (opt-in, `--profile monitoring`). See
# ../monitoring/README.md "Postgres role for postgres-exporter".
POSTGRES_MONITORING_PASSWORD=monitoring-local

REDIS_HOST=redis
REDIS_PORT=6379

# Backs request.session during the OIDC redirect roundtrip only. Must be at least 32
# characters. Generate with `python -c 'import secrets; print(secrets.token_urlsafe(48))'`.
OAUTH_STATE_SECRET=change-me-change-me-change-me-change-me-change-me
# Set OAUTH_COOKIE_SECURE=false for local HTTP dev (cookies require HTTPS by default).
OAUTH_COOKIE_SECURE=true
# Public base URL the IdP will redirect back to (must match the value registered with each IdP).
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
# Google OIDC client, from a Google Cloud project (External consent screen, app kept in
# Testing mode with your address on the test-user list — no Workspace needed). Register
# $OAUTH_REDIRECT_BASE_URL/api/v1/auth/oidc/google/callback as an authorized redirect URI.
# Leave both blank to disable Google login; setting only one is a startup error.
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=

# CORS origins (JSON list). Credentials are on, so no "*"; empty disables CORS.
CORS_ORIGINS=["http://localhost:5173"]

# Auth — required to issue / verify session JWTs. Must be at least 32 characters.
# Generate with `python -c 'import secrets; print(secrets.token_urlsafe(48))'`.
SESSION_JWT_SECRET=change-me-change-me-change-me-change-me-change-me
SESSION_JWT_ALGORITHM=HS256
SESSION_TTL_SECONDS=86400
REFRESH_TOKEN_TTL_SECONDS=2592000
# Absolute max age of a refreshed session (must exceed REFRESH_TOKEN_TTL_SECONDS).
REFRESH_ABSOLUTE_MAX_LIFETIME_SECONDS=7776000

# Symmetric key used to encrypt AI-model API keys at rest (JWE `dir`+`A256GCM`).
# Must be at least 32 characters. New ciphertexts are tagged with this key's id.
# Generate with `python -c 'import secrets; print(secrets.token_urlsafe(48))'`.
MODEL_SECRETS_KEY=change-me-change-me-change-me-change-me-change-me

# Required: the key sealing the message text of conversations under a licence that
# protects conversation data. Deliberately its own key, never MODEL_SECRETS_KEY —
# the two datasets keep separate blast radii, so rotating or losing one leaves the
# other readable. Must be at least 32 characters. Generate as above.
CONVERSATION_SECRETS_KEY=change-me-too-change-me-too-change-me-too-change-me
# Outgoing transcript key during a rotation. Rows written under it keep opening while
# it stays set; run `make rewraptranscripts` and only drop it once that run exits 0 —
# dropping it earlier makes those transcripts unreadable.
# CONVERSATION_SECRETS_KEY_RETIRED=

# Outgoing key during a rotation window. Set this to the *previous*
# MODEL_SECRETS_KEY so existing ciphertexts keep decrypting.
#
# NOTHING re-wraps model credentials: drop this key with any still sealed under
# it and every affected model needs its API key typed in again before dispatch
# works. Re-enter them by hand first.
#
# Transcripts are unaffected — they have their own key (CONVERSATION_SECRETS_KEY)
# and their own sweep.
# MODEL_SECRETS_KEY_RETIRED=

# Per-provider default API keys. The gateway uses these when an AI-model row has
# no api_key of its own. Leave blank if you only register models with their
# own credentials. `aws_bedrock` and `generic` have no env-var fallback.
# HUGGINGFACE_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_API_KEY=
# COHERE_API_KEY=

# Credential for the opt-in self-hosted SLM (`make upllm`). Non-secret: the local
# llama.cpp server enforces this exact value and litellm just needs it non-empty.
# One source — the compose `--api-key`, the seeded `local-slm` row, and the e2e
# test all read it; change here to rotate all three.
SLM_API_KEY=local

CELERY_BROKER_URL=redis://redis:6379/1

# Reaper for orphaned `streaming` message placeholders (hard-crash cleanup).
# TTL must exceed the longest real generation so an in-flight stream is never reaped.
# Default: reap placeholders stuck >15 min, swept every 5 min (Celery beat).
STREAMING_REAP_TTL_SECONDS=900
STREAMING_REAP_INTERVAL_SECONDS=300

# Hard cap on conversations per conversation group (batch-create + add/move + restore).
MAX_CONVERSATION_GROUP_SIZE=4

# How long a soft-deleted item stays restorable, in days. Bounds both the `?deleted=true`
# listings and the restore endpoints; never published to clients, so retuning it needs no
# client change. Nothing purges a tombstone past the window — it just stops being addressable.
RESTORE_WINDOW_DAYS=7

# Asynchronous exports (generated in the background, stored for download).
# EXPORT_STORAGE_BACKEND selects the store: "local" (filesystem) or "s3".
#   local: EXPORT_STORAGE_DIR is where finished files are written — in Docker this must be a
#          volume shared by `app` (serves downloads) and `worker` (generates them); the compose
#          mount maps to /src/var/exports. (Unneeded with s3 — both talk to S3.)
#   s3:    set EXPORT_S3_BUCKET (+ optional EXPORT_S3_PREFIX); region reuses AWS_REGION and
#          credentials come from the default boto3 chain (AWS_* env / instance profile), not here.
EXPORT_STORAGE_BACKEND=local
EXPORT_STORAGE_DIR=var/exports
# EXPORT_S3_BUCKET=my-export-bucket
# EXPORT_S3_PREFIX=exports/
# A finished file is downloadable this long after completion, then the reaper drops it (default
# 24h), sweeping every EXPORT_REAP_INTERVAL_SECONDS (Celery beat, default hourly).
EXPORT_JOB_TTL_SECONDS=86400
EXPORT_REAP_INTERVAL_SECONDS=3600

# Uploaded images (covers/avatars/icons), stored behind a generic media port.
# MEDIA_STORAGE_BACKEND selects the store: "local" (filesystem) or "s3".
#   local: MEDIA_STORAGE_DIR is where uploaded images are written — in Docker this must be a
#          volume on `app` (which both stores uploads and serves them); compose maps it to
#          /src/var/media. (Unneeded with s3.)
#   s3:    set MEDIA_S3_BUCKET (+ optional MEDIA_S3_PREFIX); region reuses AWS_REGION and
#          credentials come from the default boto3 chain (AWS_* env / instance profile), not here.
MEDIA_STORAGE_BACKEND=local
MEDIA_STORAGE_DIR=var/media
# MEDIA_S3_BUCKET=my-media-bucket
# MEDIA_S3_PREFIX=images/
# MEDIA_URL_SIGNING_SECRET signs the time-limited /images/signed URLs; leave unset to reuse
# SESSION_JWT_SECRET. Set it (>=32 chars) to rotate media-URL signing independently.
# MEDIA_URL_SIGNING_SECRET=change-me-change-me-change-me-change-me-change-me

# Orphan GC for uploaded media: an asset older than MEDIA_ORPHAN_GRACE_HOURS (default 7 days)
# that no consumer references (evaluation covers, message attachments) is soft-deleted and its
# blob removed, sweeping every MEDIA_ORPHAN_REAP_INTERVAL_SECONDS (Celery beat, default daily).
MEDIA_ORPHAN_GRACE_HOURS=168
MEDIA_ORPHAN_REAP_INTERVAL_SECONDS=86400

# Inactivity alerting for warmup-enabled (scale-to-zero) models: admins are emailed once a model
# has gone its own `inactivity_alert_hours` without a message (per-model, opt-in; warmups do not
# count as use). This knob is only the sweep cadence (Celery beat, default hourly).
MODEL_INACTIVITY_CHECK_INTERVAL_SECONDS=3600

# Default DATA license for evaluation/conversation data (the platform default
# shipped with the release; overridable at runtime via PATCH /api/v1/platform-settings).
# Must be a valid SPDX id from the catalog (app/core/licenses/catalog.py).
PLATFORM_DEFAULT_DATA_LICENSE=CC-BY-4.0

LOG_LEVEL=INFO
# Local dev default: human-readable, colored console logs. Prod/deploy sets json.
LOG_FORMAT=console
# `service` field on JSON log lines. Compose overrides it to ai-red-teaming-worker
# for the worker/beat services; leave the default for the API.
# SERVICE_NAME=ai-red-teaming-api

# Error reporting (opt-in) — unset = disabled. Uses the Sentry SDK protocol; point it at a
# Sentry-compatible endpoint (a self-hosted GlitchTip) to enable it. See README "Error reporting".
# Testing against `make mon-up`'s GlitchTip: use its compose service host (glitchtip:8080), not
# the localhost:8090 DSN shown in its UI — that host isn't reachable from inside this container.
# SENTRY_DSN=https://examplePublicKey@your-glitchtip-host/1

# Email delivery backend: console (log-only, default) | ses (AWS SESv2) | smtp.
EMAIL_BACKEND=console
# Sender address. Must be a verified identity when EMAIL_BACKEND=ses.
EMAIL_FROM=noreply@example.com
# Optional postal / company line for the email footer. Left unset = omitted.
# EMAIL_FOOTER_ADDRESS=Humane Intelligence, 123 Example St, City, Country
# Branding shown in transactional mails: the entity operating the platform
# and the platform/product name. Defaults below; override per environment.
# BRAND_COMPANY=Humane Intelligence
# BRAND_PRODUCT=AI Red Teaming

# AWS region for the `ses` backend. Credentials come from the default boto3
# chain (instance profile in prod, AWS_ACCESS_KEY_ID/SECRET in env locally).
AWS_REGION=us-east-1

# SMTP backend (EMAIL_BACKEND=smtp). For local dev against the Mailpit service:
# SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_TLS=none, no auth. SMTP_TLS:
# none | starttls (587) | ssl (465). Auth is skipped when SMTP_USERNAME is unset.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=starttls

# Frontend base URL — used to compose links in transactional mails
# (e.g. invitation accept URL). No trailing slash.
FRONTEND_BASE_URL=http://localhost:5173
# How long a platform invitation token remains valid. Default: 7 days.
INVITATION_TTL_HOURS=168
# How long a self-signup email-verification token remains valid. Default: 24 hours.
EMAIL_VERIFICATION_TTL_HOURS=24
# How long a password-reset link remains valid. Default: 24 hours.
PASSWORD_RESET_TTL_HOURS=24

# Postman sync (dev-only, `make postmanpush`) — NOT app config. Leave blank unless you
# push the generated collections to your own workspace. Never commit real values.
# API key: https://go.postman.co/settings/me/api-keys
# POSTMAN_API_KEY=
# POSTMAN_WORKSPACE_ID=
