                  "value": "{{viewer_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Read the viewer's own id via `/auth/me` \u2014 used as the member to assign/remove in folder B (avoids needing `users:read`)."
          },
          "response": []
        }
      ]
