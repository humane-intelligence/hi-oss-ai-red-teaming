	"item": [
		{
			"name": "Setup",
			"item": [
				{
					"name": "1 · Log in as admin",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"auth": {
							"type": "noauth"
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Authenticate the seeded admin. Sets `run_suffix`, a per-run `live_model_alias`, and a UUID `client_msg_id`."
					},
					"response": [],
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.collectionVariables.set('run_suffix', Date.now().toString(36));",
									"pm.collectionVariables.set('live_model_alias', `live-${pm.collectionVariables.get('run_suffix')}`);",
									"pm.collectionVariables.set('client_msg_id', pm.variables.replaceIn('{{$randomUUID}}'));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('→ 200', () => pm.response.to.have.status(200));",
									"pm.collectionVariables.set('admin_token', pm.response.json().access_token);"
								]
							}
						}
					]
				},
				{
					"name": "2 · Register the model (credential optional)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{admin_token}}"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/v1/ai-models",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"ai-models"
							]
						},
						"description": "Register the live model. **The `api_key` is included only when `live_model_key` is set** (prerequest-built body) — so the collection runs green unattended (no credential → error-event path) and produces real replies when you set the key (env `live_model_key`, e.g. an OpenRouter `sk-or-...`). Default wiring: OpenRouter via `generic` provider.",
						"body": {
							"mode": "raw",
							"raw": "{{_model_body}}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const g = k => pm.environment.get(k) || pm.collectionVariables.get(k) || '';",
									"const body = {",
									"  name: `Live model ${pm.collectionVariables.get('run_suffix')}`,",
									"  model_alias: pm.collectionVariables.get('live_model_alias'),",
									"  provider: g('live_provider') || 'generic',",
									"  provider_model_id: g('live_model_id') || 'openai/gpt-4o-mini',",
									"  inference_endpoint: g('live_endpoint') || 'https://openrouter.ai/api/v1',",
									"};",
									"const key = g('live_model_key');",
									"if (key) { body.api_key = key; } else { console.log('⚠ live_model_key empty — registering WITHOUT a credential; SSE steps will carry an error event instead of a real reply.'); }",
									"pm.collectionVariables.set('_model_body', JSON.stringify(body));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('→ 201', () => pm.response.to.have.status(201));",
									"const m = pm.response.json();",
									"pm.collectionVariables.set('lv_model_id', m.id);",
									"pm.test('raw credential never returned', () => pm.expect(m).to.not.have.property('api_key'));"
								]
							}
						}
					]
				},
				{
					"name": "3 · Log in as the seeded annotator (for folder E)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"auth": {
							"type": "noauth"
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{annotator_email}}\",\n  \"password\": \"{{annotator_password}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Authenticate the seeded `annotator` (reviewer for folder E) — removes the emailed-verify-token step."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('→ 200', () => pm.response.to.have.status(200));",
									"pm.collectionVariables.set('annotator_token', pm.response.json().access_token);"
								]
							}
						}
					]
				},
				{
					"name": "4 · Capture the annotator user id",
					"request": {
						"method": "GET",
						"header": [],
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{admin_token}}"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/users?email={{annotator_email}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"users"
							],
							"query": [
								{
									"key": "email",
									"value": "{{annotator_email}}"
								}
							]
						},
						"description": "Resolve the annotator's user id for the review assignment in folder E."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('→ 200', () => pm.response.to.have.status(200));",
									"const u = pm.response.json().items.find(x => x.email === pm.collectionVariables.get('annotator_email'));",
									"pm.test('annotator found', () => pm.expect(u, 'seeded annotator').to.be.an('object'));",
									"pm.collectionVariables.set('lv_annotator_id', u.id);"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "A · Talk to a model (stateless)",
			"item": [
				{
					"name": "1 · Stream a chat completion  (SSE)",
