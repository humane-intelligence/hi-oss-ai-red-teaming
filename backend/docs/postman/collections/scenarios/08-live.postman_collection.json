								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{admin_token}}"
								}
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"model_alias\": \"{{live_model_alias}}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Say hello to a frontend developer in one short sentence.\"\n    }\n  ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/chat/stream",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"chat",
								"stream"
							]
						},
						"description": "**FE note:** the shortest path to a reply — `POST /chat/stream` resolves the model by alias and streams SSE. No persistence. With a key set you see `delta` events; without one, an `error` event (still HTTP 200)."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('→ 200', () => pm.response.to.have.status(200));",
									"const b = pm.response.text() || ''; const got = b.includes('event: delta') || b.includes('\"content\"'); pm.test(got ? 'real model reply (delta events present)' : 'transport OK — no/invalid live_model_key, assistant turn errored (set the key for a real reply)', () => pm.response.to.have.status(200));"
								]
							}
						}
					]
				}
			]
		},
