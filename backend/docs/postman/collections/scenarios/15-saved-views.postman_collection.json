									"pm.test('echoes resource + name', () => { pm.expect(d.resource).to.eql('evaluations'); pm.expect(d.name).to.include(pm.collectionVariables.get('run_suffix')); });",
									"pm.test('state normalized to full envelope', () => { pm.expect(d.state.order_by).to.eql('-created_at'); pm.expect(d.state).to.have.property('search'); });"
								]
