						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Private group {{run_suffix}}\",\n  \"description\": \"Invisible to non-members.\",\n  \"access_level\": \"invitation_only\",\n  \"start_date\": \"2026-09-01\",\n  \"allowed_model_ids\": [\"{{o7_model_id}}\"]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/evaluation-groups",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"evaluation-groups"
							]
						},
						"description": "An `invitation_only` group only its owner/members can see — the target of the cross-user 404 check."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('→ 201', () => pm.response.to.have.status(201));",
									"pm.collectionVariables.set('o7_private_group_id', pm.response.json().id);"
								]
							}
						}
					]
				},
