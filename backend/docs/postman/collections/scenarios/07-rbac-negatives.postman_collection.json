							],
							"path": [
								"api",
								"v1",
								"evaluation-groups"
							],
							"query": [
								{
									"key": "limit",
									"value": "100"
								}
							]
						},
						"description": "The invisible group never appears in a non-member's list."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
