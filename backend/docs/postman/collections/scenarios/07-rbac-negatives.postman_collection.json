								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/ai-models",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"ai-models"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"o7-{{run_suffix}}\",\n  \"model_alias\": \"o7-{{run_suffix}}\",\n  \"provider\": \"anthropic\",\n  \"provider_model_id\": \"claude-3-5-sonnet-20241022\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "A group create requires a non-empty `allowed_model_ids`, so the engagement needs a registered model first. No credential is set \u2014 nothing here talks to the provider. Captures `o7_model_id`."
					},
					"response": []
				},
				{
