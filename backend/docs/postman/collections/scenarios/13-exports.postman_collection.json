    {
      "name": "B \u00b7 Job lifecycle (queue \u2192 worker \u2192 download)",
      "item": [
        {
          "name": "1 \u00b7 Create export job",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('\u2192 202', () => pm.response.to.have.status(202));",
                  "pm.collectionVariables.set('job_id', pm.response.json().id);",
                  "pm.test('starts pending/running', () => pm.expect(pm.response.json().status).to.be.oneOf(['pending','running']));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/exports/jobs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "exports",
                "jobs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"template\": \"engagement_report\",\n  \"evaluation_group_id\": \"{{grp}}\",\n  \"idempotency_key\": \"{{idem_key}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "**202 Accepted** \u2014 the job is queued; a Celery **worker** processes it (the worker must be running). Body needs **exactly one** of `evaluation_id` / `evaluation_group_id` (400 otherwise). `idempotency_key` (a UUID) makes retries safe."
          },
          "response": []
        },
        {
          "name": "2 \u00b7 Poll job until ready",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('\u2192 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "const n = parseInt(pm.collectionVariables.get('poll_count') || '0') + 1;",
                  "pm.collectionVariables.set('poll_count', String(n));",
                  "if (j.status === 'ready') { pm.test('job ready', () => pm.expect(j.status).to.eql('ready')); }",
                  "else if (j.status === 'failed') { pm.test('job did not fail', () => pm.expect.fail('export job failed')); }",
                  "else if (n < 30) { postman.setNextRequest(pm.info.requestName); }",
                  "else { pm.test('job ready within timeout', () => pm.expect.fail('still ' + j.status + ' after ' + n + ' polls')); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/exports/jobs/{{job_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "exports",
                "jobs",
                "{{job_id}}"
              ]
            },
            "description": "Polls the job status. **Async:** re-sends itself via `postman.setNextRequest` until `status === 'ready'` (terminal success; `failed` is the error terminal). Set a ~1s delay in the Collection Runner so the worker has time between polls. `pending \u2192 running \u2192 ready`."
          },
          "response": []
        },
        {
          "name": "3 \u00b7 Download the ready job",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('\u2192 200', () => pm.response.to.have.status(200));",
                  "pm.test('streams text/csv', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/exports/jobs/{{job_id}}/download",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "exports",
                "jobs",
                "{{job_id}}",
                "download"
              ]
            },
            "description": "Streams the generated CSV. Only works once the job is `ready` (this is the audited data-egress route)."
          },
          "response": []
        },
        {
          "name": "4 \u00b7 Job appears in the scoped list",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('\u2192 200', () => pm.response.to.have.status(200));",
                  "pm.test('lists the job', () => pm.expect(pm.response.json().items.map(j => j.id)).to.include(pm.collectionVariables.get('job_id')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/exports/jobs?evaluation_group_id={{grp}}&limit=100",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "exports",
                "jobs"
              ],
              "query": [
                {
                  "key": "evaluation_group_id",
                  "value": "{{grp}}"
                },
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            },
            "description": "**Gotcha:** the jobs list is **scoped** \u2014 it requires exactly one of `evaluation_id` / `evaluation_group_id` as a query filter (400 without it), mirroring the create contract."
          },
          "response": []
        }
      ]
    },
