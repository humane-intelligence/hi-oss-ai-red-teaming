    {
      "name": "D · Read side",
      "item": [
        {
          "name": "1 · Get the evaluation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('→ 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('it is the one we built', () => pm.expect(b.id).to.eql(pm.collectionVariables.get('content_eval_id')));",
                  "pm.test('created evaluations start at status new', () => pm.expect(b.status).to.eql('new'));",
                  "pm.test('the resolved licence rides along as an object, not a bare SPDX string', () => { pm.expect(b.effective_license).to.be.an('object'); pm.expect(b.effective_license.id).to.be.a('string'); pm.expect(b.effective_license.name).to.be.a('string'); });",
                  "pm.test('the models array reflects the unassign in folder C — present but empty', () => { pm.expect(b.models).to.be.an('array'); pm.expect(b.models).to.have.lengthOf(0); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/evaluations/{{content_eval_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "evaluations",
                "{{content_eval_id}}"
              ]
            },
            "description": "The detail read. `effective_license` is resolved through the cascade (evaluation override → group override → platform default — see collection `12`), and `models` embeds the assignments folder C manages \u2014 which by this point is **empty**, because folder C step 5 unassigned the model. That empty array is asserted deliberately: it is what proves the unassign took effect on the read side, and asserting merely \"is an array\" here would pass either way."
          },
          "response": []
        },
        {
          "name": "2 · List evaluations, filtered to the parent group",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('→ 200', () => pm.response.to.have.status(200));",
                  "pm.test('our evaluation is in its group', () => pm.expect(pm.response.json().items.map(i => i.id)).to.include(pm.collectionVariables.get('content_eval_id')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/evaluations?evaluation_group_id={{group_id}}&limit=100",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "evaluations"
              ],
              "query": [
                {
                  "key": "evaluation_group_id",
                  "value": "{{group_id}}"
                },
                {
                  "key": "limit",
                  "value": "100"
                }
