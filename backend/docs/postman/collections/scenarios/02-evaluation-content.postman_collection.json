            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/scenarios/{{scenario_id_1}}/tasks/{{task_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "scenarios", "{{scenario_id_1}}", "tasks", "{{task_id}}"] },
