              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/evaluations/{{dup_eval_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "evaluations",
                "{{dup_eval_id}}"
              ]
            },
            "description": "Self-cleanup. The duplicated **group** cannot be deleted — groups have no DELETE route — so it leaks; its title carries bootstrap's suffix, which keeps it identifiable."
          },
          "response": []
        },
        {
          "name": "7 · Delete scenario 2",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('→ 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/evaluations/{{content_eval_id}}/scenarios/{{scenario_id_2}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "evaluations",
                "{{content_eval_id}}",
                "scenarios",
                "{{scenario_id_2}}"
              ]
            },
            "description": "`evaluations:update`. Folder A created two scenarios and only ever deleted tasks; this closes the scenario lifecycle. Soft delete \u2014 it drops out of every live read (step 8 and step 9 check both the detail and the list). Whether the tombstoned row retains its `position` is not observable through the API, so nothing here claims it."
          },
          "response": []
        },
        {
          "name": "8 · The deleted scenario is gone",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('→ 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/evaluations/{{content_eval_id}}/scenarios/{{scenario_id_2}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "evaluations",
                "{{content_eval_id}}",
                "scenarios",
                "{{scenario_id_2}}"
              ]
            },
            "description": "Reads as missing, with no existence leak."
          },
          "response": []
        },
        {
          "name": "9 · The remaining scenario still lists",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('→ 200', () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().items.map(i => i.id);",
                  "pm.test('scenario 1 survives', () => pm.expect(ids).to.include(pm.collectionVariables.get('scenario_id_1')));",
                  "pm.test('scenario 2 does not', () => pm.expect(ids).to.not.include(pm.collectionVariables.get('scenario_id_2')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/evaluations/{{content_eval_id}}/scenarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "evaluations",
                "{{content_eval_id}}",
                "scenarios"
              ]
            },
            "description": "A sibling delete leaves the rest of the evaluation intact."
          },
          "response": []
        }
      ],
      "description": "The admin approve/reject guards (both **409** from the create-time `new` status — the success path needs a documented `dbshell` precondition, since no route can reach `under_review`), the evaluation and group duplicate paths with `include_children`, and the scenario delete folder A left open. Self-cleaning apart from the duplicated group, which has no DELETE."
    },
    {
      "name": "Teardown",
      "item": [
        {
          "name": "1 · Update evaluation",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('→ 200', () => pm.response.to.have.status(200));"] } }],
          "request": {
