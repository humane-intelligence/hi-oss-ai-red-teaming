        {
          "name": "5 · Update scenario",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('→ 200', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/evaluations/{{content_eval_id}}/scenarios/{{scenario_id_1}}", "host": ["{{base_url}}"], "path": ["api", "v1", "evaluations", "{{content_eval_id}}", "scenarios", "{{scenario_id_1}}"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Prompt injection (refined)\"\n}", "options": { "raw": { "language": "json" } } },
            "description": "Patch a scenario field. Requires permission `evaluations:update`."
          },
          "response": []
        },
        {
          "name": "6 · Reorder scenarios",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('→ 200', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/evaluations/{{content_eval_id}}/scenarios/order", "host": ["{{base_url}}"], "path": ["api", "v1", "evaluations", "{{content_eval_id}}", "scenarios", "order"] },
            "body": { "mode": "raw", "raw": "{\n  \"scenario_ids\": [\"{{scenario_id_2}}\", \"{{scenario_id_1}}\"]\n}", "options": { "raw": { "language": "json" } } },
            "description": "Replace the order by sending the full id list in the desired sequence. Requires permission `evaluations:update`."
          },
          "response": []
        }
      ]
    },
