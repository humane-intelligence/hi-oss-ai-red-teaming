# Local (`make mon-up`): GlitchTip + its DB run as part of this stack, so all of
# GRAFANA_ADMIN_PASSWORD/GLITCHTIP_SECRET_KEY/GLITCHTIP_DB_PASSWORD are read.
# On the box: don't copy this file — render .env from SSM per README.md.
GRAFANA_ADMIN_PASSWORD=admin
GLITCHTIP_SECRET_KEY=local-dev-not-for-prod
GLITCHTIP_DB_PASSWORD=local-dev-not-for-prod

# Must match the app's own CELERY_BROKER_URL (backend/.env) — default below is
# also that setting's default. Change both together if the app ever points at
# a different broker (e.g. RabbitMQ).
CE_BROKER_URL=redis://redis:6379/1
