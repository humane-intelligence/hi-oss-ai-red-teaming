# Base URL the typed API client prepends to request paths.
# Empty = same origin; in dev the Vite proxy (vite.config.ts) forwards to the backend.
# For a non-proxied/prod setup, point at the API origin, e.g. https://api.example.com
VITE_API_BASE_URL=

# Dev-only. Where the Vite proxy forwards /api, /health and /ready.
# Read by vite.config.ts; from inside the container the host backend is host.docker.internal.
BACKEND_URL=http://host.docker.internal:8000

# Dev-only. Host+container port for the Vite dev server. Read by docker-compose + vite.config.ts.
FE_PORT=5173

# Dev-only. Extra Host headers the Vite dev server accepts, comma-separated (e.g. an ngrok
# tunnel domain). Blank = Vite's default (localhost only) — it rejects other hosts as
# DNS-rebinding protection. Set only when testing through a tunnel.
ALLOWED_HOSTS=
