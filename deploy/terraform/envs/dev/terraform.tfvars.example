# Copy to terraform.tfvars (gitignored) and fill in. The four without defaults are
# required; everything else falls back to a sensible default — see variables.tf.

aws_account_id = "000000000000"
vpc_id         = "vpc-00000000000000000"
# must be a PUBLIC subnet: the module attaches an Elastic IP
subnet_id = "subnet-00000000000000000"
# registered as an SES email identity; publish the DNS records AWS returns for it
mail_domain = "mail.example.org"

# Point the CD deploy role's OIDC trust at your own fork
# github_repo = "your-org/your-fork"

# aws_region           = "us-east-1"
# name_prefix          = "ai-red-teaming-dev"
# instance_type        = "t3.medium"
# ssm_parameter_prefix = "/aibackend/dev"
# ami_id               = "ami-…"   # null (default) resolves the newest Ubuntu 24.04
